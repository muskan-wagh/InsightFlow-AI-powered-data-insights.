# ── InsightFlow environment ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values. .env.local is
# git-ignored; keys NEVER reach client-side code (read server-side only).

# Required: get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: any chat-capable OpenRouter model id.
# Defaults to a cost-efficient free-tier model.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-253b-a16b:free
# Optional: base URL override (default https://openrouter.ai/api/v1).
# Point it at a self-hosted proxy, or at `npm run mock:llm` (http://localhost:9999)
# for a keyless deterministic demo backend.

# Optional: browser origin used as OpenRouter HTTP-Referer.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1400
